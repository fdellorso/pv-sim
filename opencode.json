{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "autoshare": false,
  "autoupdate": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      "**/__pycache__/**",
      "*.egg-info/**",
      ".git/**",
      ".pi/**",
      ".private/**"
    ]
  },
  "permission": {
    "edit": {
      ".opencode/commands/*": "deny",
      ".opencode/skills/*": "deny",
      "opencode.json": "deny",
      "tui.json": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  },
  "lsp": {
    "python": {
      "command": ["pyright", "--stdio"],
      "extensions": [".py"]
    },
    "python-ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    }
  },
  "model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "plan": {
      "model": "opencode-go/deepseek-v4-pro"
    }
  }
}
